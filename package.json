{
  "name": "spatial-entity-extraction-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Spatial Entity Extraction Engine (SEEE) - extracts spatial entities from 3D meshes",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark": "npm run benchmark --workspace @seee/sdk",
    "lint": "tsc --noEmit",
    "dev:viewer": "npm run dev --workspace viewer",
    "build:viewer": "npm run build --workspace viewer"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "tsup": "^8.0.0",
    "@types/node": "^20.11.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
